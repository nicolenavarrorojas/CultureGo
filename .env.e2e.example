# Plantilla de .env.e2e (pruebas E2E con Playwright). Copiar a .env.e2e y completar; .env.e2e no se versiona.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Completar a mano: Supabase → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

E2E_EMAIL_PATTERN=
E2E_U1_EMAIL=
E2E_U1_PASS=
E2E_U2_EMAIL=
E2E_U2_PASS=
E2E_ADM_EMAIL=
E2E_ADM_PASS=

# Los completa el seed (npm run e2e:seed)
E2E_U1_ID=
E2E_L1_ID=
E2E_L1_LAT=
E2E_L1_LNG=
